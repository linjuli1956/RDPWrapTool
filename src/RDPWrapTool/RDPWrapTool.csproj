<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8: inbox on Win10 1903+ / Win11 -> truly portable EXE (~1-3MB) -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RDPWrapTool</AssemblyName>
    <RootNamespace>RDPWrapTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Framework assemblies not in the default SDK-style reference set -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allows building net48 on machines without the targeting pack installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="rdpwrap.dll" LogicalName="RDPWrapTool.Assets.rdpwrap.dll" />
    <EmbeddedResource Include="rdpwrap.ini" LogicalName="RDPWrapTool.Assets.rdpwrap.ini" />
  </ItemGroup>

</Project>
